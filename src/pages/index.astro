---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';
import { getAllCategories } from '../lib/categories';
import { getAllPublishers } from '../lib/publishers';

export const prerender = true;

const games = await getAllGames(getDatabase());
const categories = await getAllCategories(getDatabase());
const publishers = await getAllPublishers(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <div class="flex flex-col gap-4 mb-6 sm:flex-row sm:items-end sm:justify-between">
        <h2 class="text-2xl font-medium text-slate-100">Featured Games</h2>

        <form id="game-filters" class="grid gap-4 rounded-xl border border-slate-700 bg-slate-800/70 p-4 sm:grid-cols-2" aria-label="Filter games">
          <div>
            <label for="category-filter" class="mb-2 block text-sm font-medium text-slate-200">Categories</label>
            <select
              id="category-filter"
              name="category"
              multiple
              size={Math.min(Math.max(categories.length, 1), 5)}
              class="min-w-52 rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
              data-testid="category-filter"
            >
              {categories.map((category) => <option value={category.id}>{category.name}</option>)}
            </select>
          </div>

          <div class="flex flex-col">
            <label for="publisher-filter" class="mb-2 block text-sm font-medium text-slate-200">Publisher</label>
            <select
              id="publisher-filter"
              name="publisher"
              class="rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
              data-testid="publisher-filter"
            >
              <option value="">All publishers</option>
              {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
            </select>
            <button
              type="button"
              id="clear-filters"
              class="mt-3 self-start rounded-lg px-3 py-2 text-sm text-slate-300 transition-colors hover:bg-slate-700 hover:text-white focus:outline-none focus:ring-2 focus:ring-blue-500"
              data-testid="clear-filters"
            >
              Clear filters
            </button>
          </div>
        </form>
      </div>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <div id="games-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
        </div>
      )}
      <div id="filtered-empty-state" class="hidden" data-testid="filtered-empty-state" aria-live="polite">
        <EmptyState text="No games match the selected filters." />
      </div>
      <p id="filter-status" class="sr-only" role="status" aria-live="polite" data-testid="filter-status"></p>
    </div>
  </div>
</Layout>

<script>
  const filterForm = document.getElementById('game-filters');
  const categoryFilter = document.getElementById('category-filter');
  const publisherFilter = document.getElementById('publisher-filter');
  const clearFilters = document.getElementById('clear-filters');
  const gamesGrid = document.getElementById('games-grid');
  const filteredEmptyState = document.getElementById('filtered-empty-state');
  const filterStatus = document.getElementById('filter-status');

  if (
    filterForm instanceof HTMLFormElement &&
    categoryFilter instanceof HTMLSelectElement &&
    publisherFilter instanceof HTMLSelectElement &&
    clearFilters instanceof HTMLButtonElement &&
    gamesGrid &&
    filteredEmptyState &&
    filterStatus
  ) {
    const gameCards = Array.from(gamesGrid.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
    const params = new URLSearchParams(window.location.search);
    const selectedCategories = new Set(params.getAll('category'));
    const selectedPublisher = params.get('publisher') ?? '';

    Array.from(categoryFilter.options).forEach((option) => {
      option.selected = selectedCategories.has(option.value);
    });
    publisherFilter.value = selectedPublisher;

    const updateUrl = (categoryIds: string[], publisherId: string): void => {
      const nextParams = new URLSearchParams();
      categoryIds.forEach((categoryId) => nextParams.append('category', categoryId));
      if (publisherId) {
        nextParams.set('publisher', publisherId);
      }
      const query = nextParams.toString();
      window.history.replaceState({}, '', query ? `${window.location.pathname}?${query}` : window.location.pathname);
    };

    const applyFilters = (syncUrl = true): void => {
      const categoryIds = Array.from(categoryFilter.selectedOptions, (option) => option.value);
      const publisherId = publisherFilter.value;
      let visibleCount = 0;

      gameCards.forEach((card) => {
        const matchesCategory = categoryIds.length === 0 || categoryIds.includes(card.dataset.categoryId ?? '');
        const matchesPublisher = !publisherId || card.dataset.publisherId === publisherId;
        const isVisible = matchesCategory && matchesPublisher;
        card.classList.toggle('hidden', !isVisible);
        if (isVisible) {
          visibleCount += 1;
        }
      });

      filteredEmptyState.classList.toggle('hidden', visibleCount > 0);
      filterStatus.textContent = `${visibleCount} game${visibleCount === 1 ? '' : 's'} shown`;
      if (syncUrl) {
        updateUrl(categoryIds, publisherId);
      }
    };

    filterForm.addEventListener('change', () => applyFilters());
    clearFilters.addEventListener('click', () => {
      Array.from(categoryFilter.options).forEach((option) => {
        option.selected = false;
      });
      publisherFilter.value = '';
      applyFilters();
    });
    applyFilters(false);
  }
</script>
